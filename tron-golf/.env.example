# Copy to .env.local and fill in your values. .env.local is gitignored.
#
# Google Cloud Console: enable "Maps JavaScript API" and "Maps Static API"
# on the same key, then restrict the key by HTTP referrer before deploying.
VITE_GOOGLE_MAPS_KEY=your_key_here

# Map ID of a VECTOR map. Required for the map to rotate tee -> green.
#
# Google Cloud Console -> Google Maps Platform -> Map Management -> Create Map ID
#   Map type:   JavaScript
#   Rendering:  Vector          <-- must be Vector, not Raster
#   Tick:       Tilt, Rotation
#
# Without this the API builds a RASTER map, and on raster maps heading is only
# honoured at 45-degree imagery zoom levels — so a top-down satellite view
# ignores setHeading() entirely, with no error. The app still runs; the map
# just stays north-up.
VITE_GOOGLE_MAPS_ID=your_vector_map_id_here
